APP_ENV=development
PORT=3333
HOST_PORT=3333
GO_VERSION=1.26.6

DB_HOST=db
DB_PORT=3306
DB_PUBLISHED_PORT=3306
DB_NAME=secretaria
DB_USER=secretaria
DB_PASSWORD=change-me-local
DB_ROOT_PASSWORD=change-me-root-local
DB_TLS=false
DB_TLS_SKIP_VERIFY=false

OIDC_ISSUER=https://<project-ref>.supabase.co/auth/v1
OIDC_AUDIENCE=authenticated
AUTH_REQUIRE_VERIFIED_EMAIL=false
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=
BOOTSTRAP_SUPER_ADMIN_EMAIL=
